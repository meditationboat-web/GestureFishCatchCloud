*.so
**/*.framework/*
!**/*.framework/*.meta

bazel-*

Assets/StreamingAssets*

# The fish game loads these CPU models from StreamingAssets at runtime.
# Keep only the required models in the cloud repository.
!Assets/StreamingAssets/
!Assets/StreamingAssets/hand_landmarker.bytes
!Assets/StreamingAssets/hand_landmarker.bytes.meta
!Assets/StreamingAssets/pose_landmarker_lite.bytes
!Assets/StreamingAssets/pose_landmarker_lite.bytes.meta

Packages/com.github.homuler.mediapipe/PackageResources/MediaPipe/*
!Packages/com.github.homuler.mediapipe/PackageResources/MediaPipe/*.meta
Packages/com.github.homuler.mediapipe/PackageResources/MediaPipe/object_detection_3d.bytes.meta
Packages/com.github.homuler.mediapipe/Runtime/Plugins/Protobuf/*.dll

# MediaPipe protobuf C# sources and Google.Protobuf are required when Unity
# imports the package in a clean cloud workspace.
!Packages/com.github.homuler.mediapipe/Runtime/Plugins/Protobuf/
!Packages/com.github.homuler.mediapipe/Runtime/Plugins/Protobuf/*.dll
!Packages/com.github.homuler.mediapipe/Runtime/Plugins/Protobuf/*.dll.meta
!Packages/com.github.homuler.mediapipe/Runtime/Scripts/Protobuf/
!Packages/com.github.homuler.mediapipe/Runtime/Scripts/Protobuf/**/*.cs
!Packages/com.github.homuler.mediapipe/Runtime/Scripts/Protobuf/**/*.cs.meta

# Required by the Android MediaPipe build.
!Packages/com.github.homuler.mediapipe/Runtime/Plugins/libmediapipe_c.so
!Packages/com.github.homuler.mediapipe/Runtime/Plugins/libmediapipe_c.so.meta
!Packages/com.github.homuler.mediapipe/Runtime/Plugins/Android/mediapipe_android.aar
!Packages/com.github.homuler.mediapipe/Runtime/Plugins/Android/mediapipe_android.aar.meta
